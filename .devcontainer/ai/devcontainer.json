{
  "name": "ai--${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "vscode",
  "postCreateCommand": "echo \"alias ll='ls -alF'\" >> $HOME/.bashrc",
  "postStartCommand": "sudo chown -R vscode:vscode /vscode || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "maattdd.gitless",
        "yoavbls.pretty-ts-errors",
        "anthropic.claude-code",
        "openai.chatgpt",
        "Google.geminicodeassist"
      ]
    }
  }
}
